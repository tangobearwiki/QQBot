class StardewMatchPlugin(Star):
    def __init__(self, context: Context, config: dict | None = None):
        super().__init__(context, config)
        self.config = config or {}
        self.reg: dict[str, dict] = {}
        self.reco: dict[str, dict] = {}
        self.bot = None
        self.cooldowns: dict[str, float] = {}
        self._task: asyncio.Task | None = None
        self._running = False
        self._lock = asyncio.Lock()
        self.rooms = RoomManager(self)

    # ------------------------------------------------------------------ #
    # 生命周期
    # ------------------------------------------------------------------ #
    async def initialize(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        self._reg_load()
        await self._init_db()
        try:
            self.context.register_web_api(
                "/astrbot_plugin_stardew_match/stats",
                self._page_stats,
                ["GET"],
                "星露谷匹配统计",
            )
            self.context.register_web_api(
                "/astrbot_plugin_stardew_match/admin",
                self._page_admin,
                ["POST"],
                "星露谷匹配管理",
            )
        except Exception:  # noqa: BLE001
            logger.exception("[星露谷匹配] 注册统计页面 API 失败")
        self._running = True
        self._task = asyncio.create_task(self._match_loop())
        logger.info("[星露谷匹配] 插件已启动，数据库：%s", DB_PATH)

    async def terminate(self):
        self._running = False
        if self._task:
            self._task.cancel()
            with suppress(asyncio.CancelledError):
                await self._task
        logger.info("[星露谷匹配] 插件已停止")

    async def _init_db(self):
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute("PRAGMA journal_mode=WAL")
            await db.executescript(SCHEMA)
            await db.commit()
        await self._migrate_db()

    async def _migrate_db(self):
        async with self._db() as db:
            for table in ("players", "queue"):
                rows = await (
                    await db.execute(f"PRAGMA table_info({table})")
                ).fetchall()
                columns = {row["name"] for row in rows}
                if "gender" not in columns:
                    await db.execute(
                        f"ALTER TABLE {table} ADD COLUMN gender TEXT NOT NULL DEFAULT 'secret'"
                    )
                if "prefer_gender" not in columns:
                    await db.execute(
                        f"ALTER TABLE {table} ADD COLUMN prefer_gender TEXT NOT NULL DEFAULT 'any'"
                    )
                if "nickname" not in columns:
                    await db.execute(
                        f"ALTER TABLE {table} ADD COLUMN nickname TEXT DEFAULT ''"
                    )
            match_columns = {
                row["name"]
                for row in await (
                    await db.execute("PRAGMA table_info(matches)")
                ).fetchall()
            }
            if "forced" not in match_columns:
                await db.execute(
                    "ALTER TABLE matches ADD COLUMN forced INTEGER NOT NULL DEFAULT 0"
                )
            if "room_id" not in match_columns:
                await db.execute(
                    "ALTER TABLE matches ADD COLUMN room_id INTEGER NOT NULL DEFAULT 0"
                )
            await db.commit()

    @asynccontextmanager
    async def _db(self):
        db = await aiosqlite.connect(DB_PATH)
        db.row_factory = aiosqlite.Row
        try:
            yield db
        finally:
            await db.close()

    def _reg_save(self) -> None:
        """问卷进度落盘，重启后可续答。"""
        try:
            REG_PATH.write_text(
                json.dumps(self.reg, ensure_ascii=False), encoding="utf-8"
            )
        except OSError as exc:
            logger.warning("[星露谷匹配] 报名进度落盘失败: %s", exc)

    def _reg_load(self) -> None:
        try:
            data = json.loads(REG_PATH.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                self.reg = data
        except (OSError, ValueError):
            pass

    # ------------------------------------------------------------------ #
    # 工具
    # ------------------------------------------------------------------ #
    @staticmethod
    def _now() -> datetime:
        return datetime.now()

    @classmethod
    def _iso(cls, dt: datetime | None = None) -> str:
        return (dt or cls._now()).isoformat(timespec="seconds")

    def _cfg_int(self, key: str, default: int) -> int:
        try:
            return int(self.config.get(key, default))
        except (TypeError, ValueError):
            return default

    def _cfg_bool(self, key: str, default: bool) -> bool:
        value = self.config.get(key, default)
        if isinstance(value, bool):
            return value
        if isinstance(value, str):
            return value.strip().lower() in {"1", "true", "yes", "on"}
        return bool(value)

    def _remember_bot(self, event: AstrMessageEvent):
        bot = getattr(event, "bot", None)
        if bot is not None:
            self.bot = bot

    def _get_bot(self):
        if self.bot is not None:
            return self.bot
        try:
            for inst in self.context.platform_manager.get_insts():
                bot = getattr(inst, "bot", None)
                if bot is not None:
                    self.bot = bot
                    return bot
        except Exception:  # noqa: BLE001
            pass
        return None

    def _sender(self, event: AstrMessageEvent) -> str:
        return str(event.get_sender_id() or "").strip()

    async def _reply(self, event: AstrMessageEvent, text: str):
        try:
            await event.send(MessageChain([Plain(text)]))
        except Exception as exc:  # noqa: BLE001
            logger.warning("[星露谷匹配] 回复发送失败: %s", exc)

    async def _send_private(
        self,
        qq: str,
        text: str,
        event: AstrMessageEvent | None = None,
        group_id: str | int | None = None,
    ) -> bool:
        bot = self._get_bot()
        if event is not None:
            bot = getattr(event, "bot", None) or bot
        if bot is None or not qq.isdigit():
            logger.warning("[星露谷匹配] 无可用 bot，无法私聊 %s", qq)
            return False
        gid = None
        if group_id is not None and str(group_id).isdigit():
            gid = int(group_id)
        elif event is not None:
            event_gid = str(event.get_group_id() or "")
            if event_gid.isdigit():
                gid = int(event_gid)
        # 优先用群临时会话，避免必须加好友
        if gid is not None:
            call = getattr(bot, "call_action", None)
            if call is not None:
                try:
                    await call(
                        "send_private_msg",
                        user_id=int(qq),
                        group_id=gid,
                        message=text,
                    )
                    return True
                except Exception as exc:  # noqa: BLE001
                    logger.info(
                        "[星露谷匹配] 临时会话 %s（群 %s）失败，尝试好友私聊: %s",
                        qq,
                        gid,
                        exc,
                    )
        try:
            await bot.send_private_msg(user_id=int(qq), message=text)
            return True
        except Exception as exc:  # noqa: BLE001
            logger.warning("[星露谷匹配] 私聊 %s 失败: %s", qq, exc)
            return False

    async def _send_group(
        self, group_id: str, text: str, event: AstrMessageEvent | None = None
    ) -> bool:
        bot = self._get_bot()
        if event is not None:
            bot = getattr(event, "bot", None) or bot
        if bot is None or not str(group_id).isdigit():
            return False
        try:
            await bot.send_group_msg(group_id=int(group_id), message=text)
            return True
        except Exception as exc:  # noqa: BLE001
            logger.warning("[星露谷匹配] 群消息 %s 失败: %s", group_id, exc)
            return False

    async def _send_group_at(
        self, group_id: str | int, qq: str, text: str
    ) -> bool:
        """群内 @ 某人发提醒（私聊失败时的兜底通道）。"""
        bot = self._get_bot()
        if bot is None or not str(group_id).isdigit() or not str(qq).isdigit():
            return False
        try:
            await bot.send_group_msg(
                group_id=int(group_id),
                message=[At(qq=int(qq)), Plain(" " + text)],
            )
            return True
        except Exception as exc:  # noqa: BLE001
            logger.warning(
                "[星露谷匹配] 群内@提醒 %s（群 %s）失败: %s", qq, group_id, exc
            )
            return False

    async def _notice(
        self,
        qq: str,
        text: str,
        group_id: str | int | None,
        fallback: str,
    ) -> bool:
        """关键通知：私聊优先，失败则群内 @ 兜底（fallback 不得含隐私信息）。"""
        ok = await self._send_private(qq, text, group_id=group_id)
        if not ok and group_id and str(group_id).isdigit():
            await self._send_group_at(group_id, qq, fallback)
        return ok

    def _is_admin(self, event: AstrMessageEvent) -> bool:
        qq = self._sender(event)
        admins = self.config.get("admins", [])
        if isinstance(admins, str):
            admins = [x for x in re.split(r"[,，\s]+", admins) if x]
        try:
            global_admins = self.context.get_config().get("admins_id", []) or []
            admins = list(admins) + list(global_admins)
        except Exception:  # noqa: BLE001
            pass
        if qq in {str(x).strip() for x in admins}:
            return True
        try:
            if event.is_admin():
                return True
        except Exception:  # noqa: BLE001
            pass
        return getattr(event, "role", "") == "admin"

    @staticmethod
    def _extract_at(event: AstrMessageEvent) -> str | None:
        for seg in event.get_messages():
            if isinstance(seg, At):
                qq = str(getattr(seg, "qq", "")).strip()
                if qq.isdigit():
                    return qq
        return None

    # ------------------------------------------------------------------ #
    # 报名状态机
    # ------------------------------------------------------------------ #
    @filter.command("p")
    async def p(self, event: AstrMessageEvent):
        await self._handle_p(event)

    @filter.regex(r"^\s*/p(?:\s|$)")
    async def p_slash(self, event: AstrMessageEvent):
        event.is_wake = True
        event.is_at_or_wake_command = True
        await self._handle_p(event)

    @filter.event_message_type(filter.EventMessageType.ALL, priority=1)
    async def p_watch(self, event: AstrMessageEvent):
        text = event.get_message_str().strip()
        if "p" in text.lower() or "帮助" in text:
            logger.info("[星露谷匹配] watcher raw=%r", text)
        if text in {"帮助", "help"}:
            await self._cmd_help(event, "")
            return
        if re.match(r"^\s*(?:/p|sp|p)(?:\s|$)", text):
            event.is_wake = True
            event.is_at_or_wake_command = True
            await self._handle_p(event)

    async def _handle_p(self, event: AstrMessageEvent):
        if event.get_extra("stardew_p_handled"):
            return
        event.set_extra("stardew_p_handled", True)
        self._remember_bot(event)
        event.call_llm = False
        raw = event.get_message_str().strip()
        logger.debug(
            "[星露谷匹配] 命令进入: raw=%r wake=%s private=%s",
            raw,
            getattr(event, "is_at_or_wake_command", None),
            event.is_private_chat(),
        )
        if raw.startswith("/"):
            raw = raw[1:]
        if raw.startswith("sp"):
            raw = raw[1:]
        parts = raw.split(None, 1)
        if not parts or parts[0].lower() != "p":
            return
        rest = parts[1].strip() if len(parts) > 1 else ""
        sub, _, arg = rest.partition(" ")
        sub = sub.strip()
        arg = arg.strip()

        handlers = {
            "报名": self._cmd_join,
            "状态": self._cmd_status,
            "房间": self._cmd_rooms,
            "取消": self._cmd_cancel,
            "确认": self._cmd_confirm,
            "拒绝": self._cmd_reject,
            "完成": self._cmd_done,
            "举报": self._cmd_report,
            "帮助": self._cmd_help,
            "封禁": self._cmd_ban,
            "解封": self._cmd_unban,
            "统计": self._cmd_stats,
            "解散": self._cmd_dissolve,
            "队列": self._cmd_queue,
        }
        handler = handlers.get(sub)
        if handler is None:
            await self._cmd_help(event, "")
            return
        await handler(event, arg)

    @filter.event_message_type(filter.EventMessageType.PRIVATE_MESSAGE, priority=100)
    async def on_private_message(self, event: AstrMessageEvent):
        qq = self._sender(event)
        state = self.reg.get(qq)
        if not state:
            if qq not in self.reco:
                return
            text = event.get_message_str().strip()
            if not text:
                return
            low = text.lower()
            if low == "p" or low.startswith("p ") or low.startswith("/p"):
                return
            self._remember_bot(event)
            event.call_llm = False
            await self._reco_answer(event, qq, text)
            return
        text = event.get_message_str().strip()
        if not text:
            return
        low = text.lower()
        if low == "p" or low.startswith("p ") or low.startswith("/p"):
            return
        self._remember_bot(event)
        event.call_llm = False
        await self._registration_answer(event, qq, state, text)
        self._reg_save()

    async def _reco_answer(self, event: AstrMessageEvent, qq: str, text: str) -> bool:
        """房间推荐交互：同意/换一个。返回是否消费了该消息。"""
        st = self.reco.get(qq)
        if st is None:
            return False
        low = text.strip().lower()
        if low in {"1", "y", "yes", "好", "同意", "加入", "行", "好呀", "可以"}:
            await self._accept_recommendation(event, qq)
            return True
        if low in {"2", "n", "no", "不", "换", "下一个", "不了", "算了"}:
            await self._next_recommendation(event, qq)
            return True
        await self._reply(
            event,
            "请回复「1」加入推荐的房间，或「2」看看下一个；"
            "不想换房可继续等待，发送 /p 取消 可退出当前房间。",
        )
        return True

    @staticmethod
    def _parse_pool(text: str) -> str | None:
        return POOL_ALIASES.get(text.strip().lower())

    @staticmethod
    def _parse_modded(text: str) -> int | None:
        t = text.strip().lower()
        if t in {"1", "原版", "vanilla", "无模组", "无mod"}:
            return 0
        if t in {"2", "模组", "mod", "modded", "有模组"}:
            return 1
        return None

    @staticmethod
    def _parse_slots(text: str) -> list[str] | None:
        tokens = [x for x in re.split(r"[,，、\s]+", text.strip()) if x]
        result: list[str] = []
        for token in tokens:
            slot = SLOT_ALIASES.get(token.strip().lower())
            if slot and slot not in result:
                result.append(slot)
        return result or None

    @staticmethod
    def _parse_target(text: str) -> int | None:
        try:
            value = int(text.strip())
        except ValueError:
            return None
        return value if 2 <= value <= 4 else None

    @staticmethod
    def _parse_have(text: str, target: int) -> int | None:
        try:
            value = int(text.strip())
        except ValueError:
            return None
        return value if 1 <= value < target else None

    @staticmethod
    def _parse_qq(text: str, fallback: str) -> str | None:
        t = text.strip()
        if t in {"默认", "default", "当前", "自己"}:
            return fallback
        if t.isdigit() and 5 <= len(t) <= 12:
            return t
        return None

    @staticmethod
    def _parse_steam(text: str) -> str:
        t = text.strip()
        if t in {"跳过", "skip", "无", "-"}:
            return ""
        return t[:64]

    @staticmethod
    def _pool_label(pool: str) -> str:
        return POOLS.get(pool, pool)

    @staticmethod
    def _modded_label(modded: int) -> str:
        return "模组" if int(modded) else "原版"

    @staticmethod
    def _slots_label(slots_json: str) -> str:
        try:
            slots = json.loads(slots_json)
        except (TypeError, ValueError):
            slots = []
        return "、".join(SLOTS.get(s, s) for s in slots) or "未填"

    def _match_summary(self, pool: str, modded: int, slots: str, size: int) -> str:
        return (
            f"{self._pool_label(pool)} / {self._modded_label(modded)} / "
            f"{self._slots_label(slots)} / 目标{size}人"
        )

    @staticmethod
    def _parse_gender(text: str) -> str | None:
        return GENDER_ALIASES.get(text.strip().lower())

    @staticmethod
    def _parse_prefer(text: str) -> str | None:
        return PREFER_ALIASES.get(text.strip().lower())

    @staticmethod
    def _gender_label(gender: str) -> str:
        return GENDERS.get(gender, "保密")

    @staticmethod
    def _prefer_label(prefer: str) -> str:
        return PREFERS.get(prefer, "不限")

    def _summary_text(self, data: dict) -> str:
        target = int(data.get("target", 0))
        have = int(data.get("have", 0))
        need = max(0, target - have)
        return (
            "请确认报名信息：\n"
            f"{self._match_summary(data['pool'], data['modded'], json.dumps(data['slots']), target)}\n"
            f"目标人数：{target} 人，我方 {have} 人，还需 {need} 人\n"
            f"性别：{self._gender_label(data['gender'])}\n"
            f"希望对方：{self._prefer_label(data['prefer_gender'])}\n"
            f"联系 QQ：{data['contact_qq']}\n"
            f"Steam：{data['contact_steam'] or '未填'}\n\n"
            "回复“确认”提交，或“上一步”修改，或“取消”放弃。"
        )

    def _question_for(self, step: str, data: dict) -> str:
        if step == "confirm":
            return self._summary_text(data)
        if step == "have":
            max_have = max(1, int(data.get("target", 4)) - 1)
            return Q_HAVE.format(max_have=max_have) + BACK_HINT
        return STEP_QUESTIONS[step] + BACK_HINT

    async def _go_back(self, event: AstrMessageEvent, state: dict):
        step = state["step"]
        if step not in STEPS:
            return
        idx = STEPS.index(step)
        if idx == 0:
            await self._reply(event, "已经是第一步了。")
            return
        prev = STEPS[idx - 1]
        state["step"] = prev
        field = STEP_FIELDS.get(prev)
        if field:
            state["data"].pop(field, None)
        await self._reply(event, self._question_for(prev, state["data"]))

    async def _registration_answer(
        self, event: AstrMessageEvent, qq: str, state: dict, text: str
    ):
        text = text.strip()
        if text in {"取消", "放弃", "退出", "0", "n", "no"}:
            self.reg.pop(qq, None)
            self._reg_save()
            await self._reply(event, "已取消报名，发送 /p 报名 可随时重新开始。")
            return
        if text in {"上一步", "返回", "back", "b", "上一页"}:
            await self._go_back(event, state)
            return

        step = state["step"]
        data = state["data"]

        if step == "pool":
            value = self._parse_pool(text)
            if value is None:
                await self._reply(event, "无效平台，请回复 1-5。")
                return
            data["pool"] = value
            state["step"] = "modded"
            await self._reply(event, self._question_for("modded", data))
            return

        if step == "modded":
            value = self._parse_modded(text)
            if value is None:
                await self._reply(event, "请回复 1（原版）或 2（模组）。")
                return
            data["modded"] = value
            state["step"] = "slots"
            await self._reply(event, self._question_for("slots", data))
            return

        if step == "slots":
            value = self._parse_slots(text)
            if value is None:
                await self._reply(event, "请至少选择一个时段，例如：3,4")
                return
            data["slots"] = value
            state["step"] = "target"
            await self._reply(event, self._question_for("target", data))
            return

        if step == "target":
            value = self._parse_target(text)
            if value is None:
                await self._reply(event, "目标人数只能是 2、3 或 4，请重新输入。")
                return
            data["target"] = value
            state["step"] = "have"
            await self._reply(event, self._question_for("have", data))
            return

        if step == "have":
            value = self._parse_have(text, int(data["target"]))
            if value is None:
                await self._reply(
                    event,
                    f"我方人数需在 1 到 {int(data['target']) - 1} 之间，请重新输入。",
                )
                return
            data["have"] = value
            state["step"] = "gender"
            await self._reply(event, self._question_for("gender", data))
            return

        if step == "gender":
            value = self._parse_gender(text)
            if value is None:
                await self._reply(event, "请回复 1（男）、2（女）或 3（保密）。")
                return
            data["gender"] = value
            state["step"] = "prefer_gender"
            await self._reply(event, self._question_for("prefer_gender", data))
            return

        if step == "prefer_gender":
            value = self._parse_prefer(text)
            if value is None:
                await self._reply(event, "请回复 1（男）、2（女）或 3（不限）。")
                return
            data["prefer_gender"] = value
            state["step"] = "qq"
            await self._reply(event, self._question_for("qq", data))
            return

        if step == "qq":
            value = self._parse_qq(text, qq)
            if value is None:
                await self._reply(event, "QQ 号格式不对，请回复 5-12 位数字，或发送“默认”。")
                return
            data["contact_qq"] = value
            state["step"] = "steam"
            await self._reply(event, self._question_for("steam", data))
            return

        if step == "steam":
            data["contact_steam"] = self._parse_steam(text)
            state["step"] = "confirm"
            await self._reply(event, self._summary_text(data))
            return

        if step == "confirm":
            if text in {"确认", "确定", "提交", "1", "y", "yes"}:
                await self._finish_registration(event, qq, state)
            elif text in {"取消", "放弃", "0", "n", "no"}:
                self.reg.pop(qq, None)
                await self._reply(event, "已取消报名。")
            else:
                await self._reply(event, "请回复“确认”提交、“上一步”修改，或“取消”放弃。")

    async def _cmd_join(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        if not qq:
            return
        if await self._is_banned(qq):
            await self._reply(event, "你已被禁止报名，请联系管理员。")
            return
        cooldown_until = self.cooldowns.get(qq, 0)
        if cooldown_until > time.time():
            remain = int(cooldown_until - time.time())
            await self._reply(event, f"你刚拒绝过匹配，请 {remain} 秒后再报名。")
            return
        if qq in self.reg:
            await self._reply(event, "你正在报名中，请按私聊提示完成，或发送“取消”。")
            return
        if await self.rooms.active(qq):
            await self._reply(event, "你已经在房间里，发送 /p 状态 查看。")
            return
        if await self._active_queue(qq):
            await self._reply(event, "你已经在队列中，发送 /p 状态 查看。")
            return
        if await self._active_match(qq):
            await self._reply(event, "你还有未完成的匹配，发送 /p 状态 查看。")
            return

        group_id = str(event.get_group_id() or "")
        self.reg[qq] = {
            "step": "pool",
            "data": {},
            "group_id": group_id,
            "nickname": event.get_sender_name() or "",
        }
        self._reg_save()

        if event.is_private_chat():
            await self._reply(event, self._question_for("pool", {}))
        else:
            ok = await self._send_private(
                qq,
                self._question_for("pool", {}),
                event,
                group_id=group_id,
            )
            if ok:
                await self._reply(
                    event,
                    "已通过群临时会话私聊你，请按提示完成报名；过程中随时可回复“上一步”修改。",
                )
            else:
                self.reg.pop(qq, None)
                self._reg_save()
                bot_qq = event.get_self_id() or ""
                hint = (
                    f" 私聊/临时会话发送失败。请加机器人 {bot_qq} 为好友，"
                    "备注“星露谷”会自动通过；"
                    "或在群里点机器人头像发临时会话，然后发送 /p 报名。"
                )
                if event.is_private_chat():
                    await self._reply(event, hint.strip())
                else:
                    await event.send(MessageChain([At(qq=qq), Plain(hint)]))

    async def _finish_registration(
        self, event: AstrMessageEvent, qq: str, state: dict
    ):
        data = state["data"]
        if await self._is_banned(qq):
            self.reg.pop(qq, None)
            await self._reply(event, "你已被禁止报名。")
            return
        if await self.rooms.active(qq):
            self.reg.pop(qq, None)
            await self._reply(event, "你已经在房间里了，发送 /p 状态 查看。")
            return
        if "target" not in data or "have" not in data:
            self.reg.pop(qq, None)
            await self._reply(event, "报名信息不完整，请重新发送 /p 报名。")
            return

        now = self._now()
        slots_json = json.dumps(data["slots"], ensure_ascii=False)
        async with self._db() as db:
            await db.execute(
                """
                INSERT INTO players
                    (qq, nickname, pool, modded, time_slots, party_size, gender,
                     prefer_gender, contact_qq, contact_steam, status,
                     created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'room', ?, ?)
                ON CONFLICT(qq) DO UPDATE SET
                    nickname=excluded.nickname,
                    pool=excluded.pool, modded=excluded.modded,
                    time_slots=excluded.time_slots, party_size=excluded.party_size,
                    gender=excluded.gender, prefer_gender=excluded.prefer_gender,
                    contact_qq=excluded.contact_qq, contact_steam=excluded.contact_steam,
                    status='room', updated_at=excluded.updated_at
                """,
                (
                    qq,
                    state.get("nickname") or qq,
                    data["pool"],
                    data["modded"],
                    slots_json,
                    data["target"],
                    data["gender"],
                    data["prefer_gender"],
                    data["contact_qq"],
                    data["contact_steam"],
                    self._iso(now),
                    self._iso(now),
                ),
            )
            await db.commit()

        self.reg.pop(qq, None)
        await self.rooms.join(
            event,
            qq,
            data,
            group_id=state.get("group_id", ""),
            nickname=state.get("nickname") or qq,
        )

