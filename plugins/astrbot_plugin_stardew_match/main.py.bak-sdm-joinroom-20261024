        if not self._is_admin(event):
            await self._reply(event, "只有管理员可以执行该命令。")
            return
        if not arg.isdigit():
            await self._reply(event, "用法：/p 解散 <匹配ID>")
            return
        match_id = int(arg)
        async with self._db() as db:
            row = await (
                await db.execute("SELECT * FROM matches WHERE id=?", (match_id,))
            ).fetchone()
            if not row:
                await self._reply(event, "匹配不存在。")
                return
            if row["status"] not in ("pending", "confirmed", "playing"):
                await self._reply(event, "该匹配已经结束。")
                return
            if row["room_id"]:
                ok, message = await self.rooms.dissolve(row["room_id"])
                await self._reply(event, message)
                return
            await db.execute(
                "UPDATE matches SET status='cancelled', closed_at=?, close_reason='dissolved' WHERE id=?",
                (self._iso(), match_id),
            )
            await self._requeue(db, row["player_a"])
            await self._requeue(db, row["player_b"])
            await db.commit()
        await self._reply(event, f"已解散匹配 #{match_id}，双方重新排队。")

