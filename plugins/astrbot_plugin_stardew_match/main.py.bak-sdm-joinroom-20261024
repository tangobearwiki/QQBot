    async def _active_queue(self, qq: str) -> bool:
        async with self._db() as db:
            await db.execute(
                """
                UPDATE queue SET status='cancelled'
                WHERE qq=? AND status='matched'
                  AND NOT EXISTS (
                    SELECT 1 FROM matches m
                    WHERE (m.player_a=queue.qq OR m.player_b=queue.qq)
                      AND m.status IN ('pending','confirmed')
                  )
                """,
                (qq,),
            )
            await db.commit()
            row = await (
                await db.execute(
                    "SELECT id FROM queue WHERE qq=? AND status IN ('waiting','matched') "
                    "ORDER BY id DESC LIMIT 1",
                    (qq,),
                )
            ).fetchone()
        return row is not None

    async def _active_match(self, qq: str) -> bool:
        async with self._db() as db:
            row = await (
                await db.execute(
                    "SELECT id FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status IN ('pending','confirmed') ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()
        return row is not None

    @staticmethod
    def _human_minutes(mins: int) -> str:
        mins = max(0, int(mins))
        if mins >= 60:
            return f"{mins // 60} 小时 {mins % 60} 分钟"
        return f"{mins} 分钟"

    async def _cmd_status(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        room_text = await self.rooms.status(qq)
        if room_text:
            await self._reply(event, room_text)
            return
        await self._active_queue(qq)
        async with self._db() as db:
            queue_row = await (
                await db.execute(
                    "SELECT * FROM queue WHERE qq=? AND status IN ('waiting','matched') "
                    "ORDER BY id DESC LIMIT 1",
                    (qq,),
                )
            ).fetchone()
            match_row = await (
                await db.execute(
                    "SELECT * FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status IN ('pending','confirmed') ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()

        if match_row:
            other = (
                match_row["player_b"]
                if match_row["player_a"] == qq
                else match_row["player_a"]
            )
            state = "待确认" if match_row["status"] == "pending" else "已确认"
            steam_line = ""
            if match_row["status"] == "confirmed":
                async with self._db() as db:
                    other_row = await (
                        await db.execute(
                            "SELECT contact_steam FROM players WHERE qq=?", (other,)
                        )
                    ).fetchone()
                other_steam = (other_row["contact_steam"] if other_row else "") or "未填"
                if event.is_private_chat():
                    steam_line = f"对方 Steam：{other_steam}\n"
                else:
                    steam_line = "对方 Steam：请私聊机器人发送 /p 状态 查看。\n"
            await self._reply(
                event,
                f"当前匹配：#{match_row['id']}（{state}）\n"
                f"对方 QQ：{other}\n"
                f"平台：{self._match_summary(match_row['pool'], match_row['modded'], '[]', match_row['party_size'])}\n"
                + steam_line
                + (
                    "发送 /p 完成 结束本次联机。"
                    if match_row["status"] == "confirmed"
                    else "在私聊回复 /p 确认 或 /p 拒绝。"
                ),
            )
            return
        if queue_row:
            mins = int(self._wait_seconds(queue_row) // 60)
            await self._reply(
                event,
                f"排队中：{self._match_summary(queue_row['pool'], queue_row['modded'], queue_row['time_slots'], queue_row['party_size'])}\n"
                f"已排队：{self._human_minutes(mins)}\n"
                "发送 /p 取消 可退出。",
            )
            return
        await self._reply(event, "你当前没有排队或匹配记录。发送 /p 报名 开始。")

    async def _cmd_cancel(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        room_text = await self.rooms.leave(qq)
        if room_text:
            await self._reply(event, room_text)
            return
        async with self._db() as db:
            queue_row = await (
                await db.execute(
                    "SELECT * FROM queue WHERE qq=? AND status='waiting' "
                    "ORDER BY id DESC LIMIT 1",
                    (qq,),
                )
            ).fetchone()
            match_row = await (
                await db.execute(
                    "SELECT * FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status IN ('pending','confirmed') ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()

            if match_row:
                other = (
                    match_row["player_b"]
                    if match_row["player_a"] == qq
                    else match_row["player_a"]
                )
                await db.execute(
                    "UPDATE matches SET status='cancelled', closed_at=?, close_reason='cancelled' WHERE id=?",
                    (self._iso(), match_row["id"]),
                )
                await self._requeue(db, other)
                await self._close_queue(db, qq, "cancelled")
                await db.execute(
                    "UPDATE players SET status='idle', updated_at=? WHERE qq=?",
                    (self._iso(), qq),
                )
                await db.commit()
                await self._notice(
                    other,
                    "对方取消了匹配，你已重新进入队列。",
                    (
                        match_row["group_b"]
                        if match_row["player_a"] == qq
                        else match_row["group_a"]
                    ),
                    "你的星露谷匹配对象取消了本次匹配，你已重新排队。",
                )
                await self._reply(event, "已取消当前匹配。")
                return

            if queue_row:
                await db.execute(
                    "UPDATE queue SET status='cancelled' WHERE id=?", (queue_row["id"],)
                )
                await db.execute(
                    "UPDATE players SET status='idle', updated_at=? WHERE qq=?",
                    (self._iso(), qq),
                )
                await db.commit()
                await self._reply(event, "已退出匹配队列。")
                return

        await self._reply(event, "你当前没有可取消的排队或匹配。")

    async def _cmd_confirm(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        if await self.rooms.active(qq):
            await self._reply(
                event, "房间满员即匹配，不需要确认；发送 /p 状态 查看房间。"
            )
            return
        async with self._db() as db:
            row = await (
                await db.execute(
                    "SELECT * FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status='pending' ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()
            if not row:
                await self._reply(event, "没有待确认的匹配。")
                return
            is_a = row["player_a"] == qq
            other = row["player_b"] if is_a else row["player_a"]
            flag_col = "confirm_a" if is_a else "confirm_b"
            if row[flag_col]:
                await self._reply(event, "你已确认，等待对方确认。")
                return
            await db.execute(
                f"UPDATE matches SET {flag_col}=1 WHERE id=?", (row["id"],)
            )
            await db.commit()
            updated = await (
                await db.execute("SELECT * FROM matches WHERE id=?", (row["id"],))
            ).fetchone()

        if updated["confirm_a"] and updated["confirm_b"]:
            await self._complete_match(updated)
            return
        await self._reply(event, "已确认，等待对方确认（5 分钟内有效）。")
        await self._notice(
            other,
            "对方已确认匹配，请尽快在私聊回复 /p 确认。",
            row["group_b"] if is_a else row["group_a"],
            "你的星露谷匹配对方已确认——请加机器人为好友后私聊回复 /p 确认。",
        )

    async def _cmd_reject(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        async with self._db() as db:
            row = await (
                await db.execute(
                    "SELECT * FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status IN ('pending','confirmed') ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()
            if not row:
                await self._reply(event, "没有可拒绝的匹配。")
                return
            other = row["player_b"] if row["player_a"] == qq else row["player_a"]
            await db.execute(
                "UPDATE matches SET status='rejected', closed_at=?, close_reason='rejected' WHERE id=?",
                (self._iso(), row["id"]),
            )
            await self._requeue(db, other)
            await self._close_queue(db, qq, "cancelled")
            await db.execute(
                "UPDATE players SET status='idle', updated_at=? WHERE qq=?",
                (self._iso(), qq),
            )
            await db.commit()

        cooldown = self._cfg_int("cooldown_sec", 600)
        self.cooldowns[qq] = time.time() + cooldown
        await self._reply(
            event, f"已拒绝本次匹配，{max(1, cooldown // 60)} 分钟内不能再次匹配。"
        )
        await self._notice(
            other,
            "对方拒绝了匹配，你已重新进入队列。",
            row["group_b"] if row["player_a"] == qq else row["group_a"],
            "你的星露谷匹配被对方拒绝，你已重新排队。",
        )

    async def _cmd_done(self, event: AstrMessageEvent, arg: str):
        qq = self._sender(event)
        room_text = await self.rooms.complete(qq)
        if room_text:
            await self._reply(event, room_text)
            return
        async with self._db() as db:
            row = await (
                await db.execute(
                    "SELECT * FROM matches WHERE (player_a=? OR player_b=?) "
                    "AND status IN ('confirmed','playing') ORDER BY id DESC LIMIT 1",
                    (qq, qq),
                )
            ).fetchone()
            if not row:
                await self._reply(event, "没有进行中的匹配。")
                return
            other = row["player_b"] if row["player_a"] == qq else row["player_a"]
            await db.execute(
                "UPDATE matches SET status='completed', closed_at=?, close_reason='completed' WHERE id=?",
                (self._iso(), row["id"]),
            )
            await self._close_queue(db, qq, "completed")
            await self._close_queue(db, other, "completed")
            await db.execute(
                "UPDATE players SET status='idle', updated_at=? WHERE qq IN (?,?)",
                (self._iso(), qq, other),
            )
            await db.commit()
        await self._reply(event, "已结束本次匹配，感谢使用。")
        await self._notice(
            other,
