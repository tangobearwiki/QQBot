        await self.rooms.kick_qq(qq)
        async with self._db() as db:
            await self._close_queue(db, qq, "cancelled")
            await db.execute(
                "UPDATE players SET status='idle', updated_at=? WHERE qq=?",
                (self._iso(), qq),
            )
            await db.commit()
        return {"ok": True, "message": f"已将 {qq} 移出房间/队列"}

    async def _admin_dissolve(self, match_id: int):
        if match_id <= 0:
            return {"ok": False, "message": "匹配 ID 不正确"}
        async with self._db() as db:
            row = await (
                await db.execute("SELECT * FROM matches WHERE id=?", (match_id,))
            ).fetchone()
            if not row:
                return {"ok": False, "message": "匹配不存在"}
            if row["status"] not in ("pending", "confirmed", "playing"):
                return {"ok": False, "message": "该匹配已经结束"}
            await db.execute(
                "UPDATE matches SET status='cancelled', closed_at=?, close_reason='dissolved' WHERE id=?",
                (self._iso(), match_id),
            )
            await self._requeue(db, row["player_a"])
            await self._requeue(db, row["player_b"])
            await db.commit()
        return {"ok": True, "message": f"已解散匹配 #{match_id}，双方重新排队"}

    async def _admin_resolve_report(self, report_id: int):
        if report_id <= 0:
            return {"ok": False, "message": "举报 ID 不正确"}
        async with self._db() as db:
            await db.execute(
                "UPDATE reports SET status='resolved' WHERE id=?", (report_id,)
            )
            await db.commit()
        return {"ok": True, "message": f"举报 #{report_id} 已标记处理"}

    # ------------------------------------------------------------------ #
    # 匹配 worker
    # ------------------------------------------------------------------ #
    async def _match_loop(self):
        while self._running:
            try:
                async with self._lock:
                    await self._tick()
            except asyncio.CancelledError:
                raise
            except Exception:  # noqa: BLE001
                logger.exception("[星露谷匹配] 匹配循环异常")
            await asyncio.sleep(max(5, self._cfg_int("match_interval_sec", 10)))

    async def _tick(self):
        await self._expire_queues()
        await self._expire_matches()
        await self.rooms.expire()
        await self.rooms.warn_expiring()
        await self._match_waiting()
        await self._check_recommendations()

    # ------------------------------------------------------------------ #
    # 房间推荐（等待 >1h → 推荐条件相近房间；隐私：只展示组队信息）
    # ------------------------------------------------------------------ #
    async def _check_recommendations(self):
        now = self._now()
        cutoff_1h = (now - timedelta(hours=1)).isoformat()
        cutoff_2h = (now - timedelta(hours=2)).isoformat()
        async with self._db() as db:
            rows = await (
                await db.execute(
                    "SELECT rm.qq, rm.group_id, rm.joined_at FROM room_members rm "
                    "JOIN rooms r ON r.id = rm.room_id "
                    "WHERE rm.active=1 AND r.status='open' AND rm.joined_at <= ?",
                    (cutoff_1h,),
                )
            ).fetchall()
        for row in rows:
            qq = row["qq"]
            waited_2h = row["joined_at"] <= cutoff_2h
            st = self.reco.get(qq)
            if st is not None:
                # 已有推荐流程：等待超 2h 且尚未放宽 → 升级为无视性别的候选再推一次
                if waited_2h and not st.get("relaxed"):
                    my = await self._my_member_row(qq)
                    if my is None:
                        self.reco.pop(qq, None)
                        continue
                    candidates = await self._room_candidates(
                        my,
                        exclude_ids={my["room_id"]} | set(st.get("rejected", [])),
                        relaxed=True,
                    )
                    if candidates:
                        self.reco[qq] = {
                            "candidates": candidates,
                            "rejected": [],
                            "current": None,
                            "group_id": row["group_id"] or "",
                            "relaxed": True,
                        }
                        await self._show_recommendation(qq)
                continue
            if qq in self.reg:
                continue
            if self.cooldowns.get(f"reco:{qq}", 0) > time.time() and not waited_2h:
                continue
            my = await self._my_member_row(qq)
            if my is None or my["joined_at"] > cutoff_1h:
                continue
            candidates = await self._room_candidates(
                my, exclude_ids={my["room_id"]}, relaxed=waited_2h
            )
            if not candidates:
                continue
            self.reco[qq] = {
                "candidates": candidates,
                "rejected": [],
                "current": None,
                "group_id": row["group_id"] or "",
                "relaxed": waited_2h,
            }
            if not await self._show_recommendation(qq):
                # 推送失败（bot 不可用或私聊失败且无群兜底）：撤销，下轮重试
                self.reco.pop(qq, None)
                fails = self.cooldowns.get(f"reco_fail:{qq}", 0) + 1
                self.cooldowns[f"reco_fail:{qq}"] = fails
                if fails >= 6:
                    self.cooldowns[f"reco:{qq}"] = time.time() + 600
                    self.cooldowns.pop(f"reco_fail:{qq}", None)

    async def _my_member_row(self, qq: str):
        async with self._db() as db:
            return await (
                await db.execute(
                    "SELECT rm.*, r.pool AS pool, r.modded AS modded, "
                    "r.time_slots AS time_slots "
                    "FROM room_members rm "
                    "JOIN rooms r ON r.id = rm.room_id "
                    "WHERE rm.qq=? AND rm.active=1 AND r.status IN ('open','full') "
                    "ORDER BY rm.id DESC LIMIT 1",
                    (qq,),
                )
            ).fetchone()

    async def _room_candidates(
        self, my, exclude_ids: set[int], relaxed: bool = False
    ) -> list[dict]:
        """同平台、人数可容纳的 open 房间，按相近度降序。

        relaxed=False 时性别偏好双向兼容为硬条件；True 时忽略性别（2h 放宽）。
        相近度 = 模组一致(+10) + 时段交集(0-5) + 空位余量。不含任何联系方式。
        """
        now = self._now()
        async with self._db() as db:
            rooms = await (
                await db.execute(
                    "SELECT * FROM rooms WHERE status='open' AND pool=? "
                    "AND expires_at > ?",
                    (my["pool"], self._iso()),
                )
            ).fetchall()
            try:
                my_slots = set(json.loads(my["time_slots"]))
            except (TypeError, ValueError):
                my_slots = set()
            scored: list[dict] = []
            for room in rooms:
                if room["id"] in exclude_ids:
                    continue
                members = await self.rooms._members(db, room["id"])
                total = sum(m["have"] for m in members)
                if total + my["have"] > room["target"]:
                    continue
                if not relaxed and not all(
                    self._gender_ok(my["prefer_gender"], m["gender"])
                    and self._gender_ok(m["prefer_gender"], my["gender"])
                    for m in members
                ):
                    continue
                try:
                    room_slots = set(json.loads(room["time_slots"]))
                except (TypeError, ValueError):
                    room_slots = set()
                score = (
                    (10 if room["modded"] == my["modded"] else 0)
                    + min(5, len(my_slots & room_slots))
                    + 1
                )
                try:
                    waited = int(
                        (now - datetime.fromisoformat(room["created_at"])).total_seconds()
                        // 60
                    )
                except (TypeError, ValueError):
                    waited = 0
                scored.append(
                    {
                        "room_id": room["id"],
                        "pool": room["pool"],
                        "modded": room["modded"],
                        "time_slots": room["time_slots"],
                        "target": room["target"],
                        "total": total,
                        "waited_min": waited,
                        "score": score,
                    }
                )
            scored.sort(key=lambda x: -x["score"])
            return scored

    async def _show_recommendation(self, qq: str) -> bool:
        st = self.reco.get(qq)
        if not st or not st["candidates"]:
            return False
        cand = st["candidates"][0]
        st["current"] = cand["room_id"]
        head = (
            "⏰ 你已等待超过 2 小时——本轮推荐已放宽性别偏好条件：\n"
            if st.get("relaxed")
            else "⏰ 你所在的房间等待较久，为你找到一个条件相近的房间，可提前汇合：\n"
        )
        text = (
            f"{head}"
            f"🏠 房间 #{cand['room_id']}（{self._pool_label(cand['pool'])} / "
            f"{self._modded_label(cand['modded'])}）\n"
            f"时段：{self._slots_label(cand['time_slots'])}\n"
            f"目标 {cand['target']} 人，当前 {cand['total']} 人，"
            f"该房已等 {self._human_minutes(cand['waited_min'])}\n"
            "回复「1」立即加入；回复「2」看下一个。\n"
            "（仅展示组队信息，不会透露任何成员联系方式）"
        )
        return await self._notice(
            qq,
            text,
            st.get("group_id"),
            "你有一条星露谷房间推荐——请加机器人为好友后私聊查看。",
        )

    async def _accept_recommendation(self, event: AstrMessageEvent, qq: str):
        st = self.reco.get(qq)
        if not st or not st.get("current"):
            return
        rid = st["current"]
        my = await self._my_member_row(qq)
        if my is None:
            self.reco.pop(qq, None)
            await self._reply(event, "你所在的房间状态已变化，发送 /p 状态 查看。")
            return
        if my["room_id"] == rid:
            self.reco.pop(qq, None)
            return
        try:
            slots = json.loads(my["time_slots"])
        except (TypeError, ValueError):
            slots = []
        data = {
            "pool": my["pool"],
            "modded": my["modded"],
            "slots": slots,
            "have": my["have"],
            "gender": my["gender"],
            "prefer_gender": my["prefer_gender"],
            "contact_qq": my["contact_qq"],
            "contact_steam": my["contact_steam"] or "",
        }
        ok, msg = await self.rooms.join_specific(
            qq,
            data,
            rid,
            group_id=st.get("group_id", ""),
            nickname=my["nickname"] or "",
            relaxed_sex=st.get("relaxed", False),
        )
        if ok:
            await self.rooms.detach_member(my["room_id"], qq)
            self.reco.pop(qq, None)
            await self._reply(event, f"✅ 已加入房间 #{rid}，原房间已退出，祝联机愉快！")
            return
        st["rejected"].append(rid)
        st["candidates"] = [c for c in st["candidates"] if c["room_id"] != rid]
        if st["candidates"]:
            await self._reply(event, f"{msg}为你换下一个：")
            await self._show_recommendation(qq)
        else:
            self.reco.pop(qq, None)
            self.cooldowns[f"reco:{qq}"] = time.time() + 1800
            await self._reply(event, f"{msg}暂时没有更多推荐，你将继续在原房间等待。")

    async def _next_recommendation(self, event: AstrMessageEvent, qq: str):
        st = self.reco.get(qq)
        if not st:
            return
        if st.get("current"):
            st["rejected"].append(st["current"])
        dropped = set(st["rejected"])
        st["candidates"] = [c for c in st["candidates"] if c["room_id"] not in dropped]
        if st["candidates"]:
            await self._show_recommendation(qq)
        else:
            self.reco.pop(qq, None)
            self.cooldowns[f"reco:{qq}"] = time.time() + 1800
            await self._reply(
                event,
                "好的，暂时没有更多相近房间，你将继续在原房间等待；"
                "30 分钟内不会再向你推荐。",
            )

    async def _cmd_rooms(self, event: AstrMessageEvent, arg: str):
        rooms = await self.rooms.list_open_rooms(limit=10)
        if not rooms:
            await self._reply(event, "当前没有等待中的房间，发送 /p 报名 创建第一个。")
