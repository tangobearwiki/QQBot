            )
        lines.append("发送 /p 报名 参加匹配；等待超过 1 小时还会收到系统推荐。")
        await self._reply(event, "\n".join(lines))

    async def _expire_queues(self):
        now = self._iso()
        async with self._db() as db:
            rows = await (
                await db.execute(
                    "SELECT * FROM queue WHERE status='waiting' AND expires_at <= ?", (now,)
                )
            ).fetchall()
            for row in rows:
                await db.execute(
                    "UPDATE queue SET status='expired' WHERE id=?", (row["id"],)
                )
                await db.execute(
                    "UPDATE players SET status='idle', updated_at=? WHERE qq=? AND status='queued'",
                    (now, row["qq"]),
                )
            if rows:
                await db.commit()
                for row in rows:
                    await self._notice(
                        row["qq"],
                        "你的匹配排队已超时，已自动退出。发送 /p 报名 可重新排队。",
                        group_id=row["group_id"],
                        fallback="你的星露谷匹配排队已超时自动退出——"
                        "请加机器人为好友后发送 /p 报名 重新排队。",
                    )

    async def _expire_matches(self):
        now = self._iso()
        async with self._db() as db:
            rows = await (
                await db.execute(
                    "SELECT * FROM matches WHERE status='pending' AND confirm_deadline <= ?",
                    (now,),
                )
            ).fetchall()
            for row in rows:
                await db.execute(
                    "UPDATE matches SET status='expired', closed_at=?, close_reason='timeout' WHERE id=?",
                    (now, row["id"]),
                )
                await self._close_queue(db, row["player_a"], "expired")
                await self._close_queue(db, row["player_b"], "expired")
                await db.execute(
                    "UPDATE players SET status='idle', updated_at=? WHERE qq IN (?,?)",
                    (now, row["player_a"], row["player_b"]),
                )
            if rows:
                await db.commit()
                for row in rows:
                    await self._notice(
                        row["player_a"],
                        "匹配确认超时，已退出本次匹配队列。如需继续请重新发送 /p 报名。",
                        group_id=row["group_a"],
                        fallback="你的星露谷匹配确认已超时退出——"
                        "请加机器人为好友后重新 /p 报名。",
                    )
                    await self._notice(
                        row["player_b"],
                        "匹配确认超时，已退出本次匹配队列。如需继续请重新发送 /p 报名。",
                        group_id=row["group_b"],
                        fallback="你的星露谷匹配确认已超时退出——"
                        "请加机器人为好友后重新 /p 报名。",
                    )

    async def _match_waiting(self) -> int:
        if self._get_bot() is None:
            return 0
        now = self._iso()
        async with self._db() as db:
            rows = await (
                await db.execute(
                    "SELECT * FROM queue WHERE status='waiting' AND expires_at > ? "
                    "ORDER BY enqueued_at ASC, id ASC",
                    (now,),
                )
            ).fetchall()
            if len(rows) < 2:
                return 0
            banned = {
                r["qq"]
                for r in await (
                    await db.execute(
                        "SELECT qq FROM bans WHERE until='' OR until > ?", (now,)
                    )
                ).fetchall()
            }
            waiting = [r for r in rows if r["qq"] not in banned]
            used: set[str] = set()
            created = 0
            for i, a in enumerate(waiting):
                if a["qq"] in used:
                    continue
                for b in waiting[i + 1 :]:
                    if b["qq"] in used:
                        continue
                    if not self._compatible(a, b):
                        continue
                    await self._create_match(db, a, b)
                    used.add(a["qq"])
                    used.add(b["qq"])
                    created += 1
                    break
            return created

    @staticmethod
    def _gender_ok(prefer: str, gender: str) -> bool:
        if prefer == "any":
            return True
        return prefer in {"male", "female"} and gender == prefer

    def _wait_seconds(self, row) -> float:
        try:
            return max(
                0.0,
                (self._now() - datetime.fromisoformat(row["enqueued_at"])).total_seconds(),
            )
        except (TypeError, ValueError):
            return 0.0

    def _relax_flags(self, a, b) -> dict[str, bool]:
        wait = min(self._wait_seconds(a), self._wait_seconds(b))

        def unlocked(key: str, default: int) -> bool:
            minutes = self._cfg_int(key, default)
            return minutes > 0 and wait >= minutes * 60

        return {
            "party_size": unlocked("relax_party_size_after_minutes", 30),
            "modded": unlocked("relax_modded_after_minutes", 60),
            "time_slots": unlocked("relax_time_slots_after_minutes", 90),
        }

    def _relaxed_labels(self, a, b) -> list[str]:
        flags = self._relax_flags(a, b)
        labels = []
        if flags["party_size"]:
            labels.append("人数")
        if flags["modded"]:
            labels.append("模式")
        if flags["time_slots"]:
            labels.append("时段")
        return labels

    def _compatible(self, a, b) -> bool:
        if a["pool"] != b["pool"]:
            return False
        if not self._gender_ok(a["prefer_gender"], b["gender"]):
            return False
        if not self._gender_ok(b["prefer_gender"], a["gender"]):
            return False
        flags = self._relax_flags(a, b)
        if not flags["party_size"] and a["party_size"] != b["party_size"]:
            return False
        if not flags["modded"] and a["modded"] != b["modded"]:
            return False
        if not flags["time_slots"]:
            try:
                slots_a = set(json.loads(a["time_slots"]))
                slots_b = set(json.loads(b["time_slots"]))
            except (TypeError, ValueError):
                return False
            if not (slots_a & slots_b):
                return False
        return True

    async def _create_match(self, db, a, b, forced: bool = False):
        now = self._now()
        timeout = self._cfg_int("confirm_timeout_sec", 300)
        deadline = now + timedelta(seconds=timeout)
        await db.execute(
            "UPDATE queue SET status='matched' WHERE id IN (?,?)", (a["id"], b["id"])
        )
        await db.execute(
            "UPDATE players SET status='matched', updated_at=? WHERE qq IN (?,?)",
            (self._iso(now), a["qq"], b["qq"]),
        )
        cursor = await db.execute(
            """
            INSERT INTO matches
                (player_a, player_b, pool, modded, party_size, status, forced,
                 confirm_a, confirm_b, created_at, confirm_deadline, group_a, group_b)
            VALUES (?,?,?,?,?,'pending',?,0,0,?,?,?,?)
            """,
            (
                a["qq"],
                b["qq"],
                a["pool"],
                a["modded"],
                a["party_size"],
                1 if forced else 0,
                self._iso(now),
                self._iso(deadline),
                a["group_id"] or "",
                b["group_id"] or "",
            ),
        )
        match_id = cursor.lastrowid
        await db.commit()
        logger.info(
            "[星露谷匹配] %s #%s: %s <-> %s (%s)",
            "强制匹配" if forced else "匹配成功",
            match_id,
            a["qq"],
            b["qq"],
            a["pool"],
        )

        minute = max(1, timeout // 60)
        summary = self._match_summary(
            a["pool"], a["modded"], a["time_slots"], a["party_size"]
        )
        name_a = a["nickname"] or a["qq"]
        name_b = b["nickname"] or b["qq"]
        relaxed = [] if forced else self._relaxed_labels(a, b)
        relax_flags = {} if forced else self._relax_flags(a, b)
        notes = []
        if forced:
            notes.append(
                "⚡ 本次为管理员强制匹配：已忽略平台/模式/人数/时段/性别等条件，"
                "请先沟通确认能否联机。"
            )
        elif relaxed:
            notes.append(f"⏱ 已按等待时间放宽：{'、'.join(relaxed)}")
        if a["party_size"] != b["party_size"]:
            notes.append(
                f"人数：{name_a} 目标 {a['party_size']} 人 / "
                f"{name_b} 目标 {b['party_size']} 人"
            )
        if a["modded"] != b["modded"]:
            notes.append(
                f"模式：{name_a} {self._modded_label(a['modded'])} / "
                f"{name_b} {self._modded_label(b['modded'])}"
            )
        if forced and a["pool"] != b["pool"]:
            notes.append(
                f"平台：{name_a} {self._pool_label(a['pool'])} / "
                f"{name_b} {self._pool_label(b['pool'])}"
            )
        if not forced and relax_flags.get("time_slots"):
            notes.append("时段：双方时段不重叠，请自行约时间")
        detail = "\n".join(notes)
        prefix = "⚡ 强制匹配" if forced else "🎮 匹配成功"

        await self._notice(
            a["qq"],
            f"{prefix}！（{summary}）\n"
            + (f"{detail}\n" if detail else "")
            + f"对方：{name_b}（QQ：{b['qq']}）\n"
            f"对方性别：{self._gender_label(b['gender'])}\n"
            f"请回复 /p 确认 或 /p 拒绝（{minute} 分钟内）。",
            group_id=a["group_id"],
            fallback=f"你有一条星露谷匹配待确认（{minute} 分钟内有效），"
            "但私聊发送失败——请加机器人为好友后私聊处理。",
        )
        await self._notice(
            b["qq"],
            f"{prefix}！（{summary}）\n"
            + (f"{detail}\n" if detail else "")
            + f"对方：{name_a}（QQ：{a['qq']}）\n"
            f"对方性别：{self._gender_label(a['gender'])}\n"
            f"请回复 /p 确认 或 /p 拒绝（{minute} 分钟内）。",
            group_id=b["group_id"],
            fallback=f"你有一条星露谷匹配待确认（{minute} 分钟内有效），"
            "但私聊发送失败——请加机器人为好友后私聊处理。",
        )
        if self._cfg_bool("anonymous_notice", True):
            if forced:
                notice = "⚡ 管理员强制匹配了 2 位群友，请查看私聊。"
            else:
                notice = "🎮 有 2 位群友匹配成功，请查看私聊。"
            group_a, group_b = str(a["group_id"] or ""), str(b["group_id"] or "")
            if group_a:
                await self._send_group(group_a, notice)
            if group_b and group_b != group_a:
                await self._send_group(group_b, notice)

    async def _complete_match(self, row):
        async with self._db() as db:
            guard = await db.execute(
                "UPDATE matches SET status='confirmed' WHERE id=? AND status='pending'",
                (row["id"],),
            )
            if guard.rowcount != 1:
                return
            a = await (
                await db.execute("SELECT * FROM players WHERE qq=?", (row["player_a"],))
            ).fetchone()
            b = await (
                await db.execute("SELECT * FROM players WHERE qq=?", (row["player_b"],))
            ).fetchone()
            await db.execute(
                "UPDATE matches SET status='confirmed' WHERE id=?", (row["id"],)
            )
            await db.execute(
                "UPDATE players SET status='playing', updated_at=? WHERE qq IN (?,?)",
                (self._iso(), row["player_a"], row["player_b"]),
            )
            await db.commit()

        if a and b:
            name_a = a["nickname"] or a["qq"]
            name_b = b["nickname"] or b["qq"]
            await self._notice(
                a["qq"],
                "✅ 双方已确认！\n"
                f"对方：{name_b}（QQ：{b['qq']}）\n"
                f"对方 Steam：{b['contact_steam'] or '未填'}\n"
                "请主动加好友联机，结束后发送 /p 完成。",
                group_id=row["group_a"],
                fallback="你的星露谷匹配已双方确认，但私聊发送失败——"
                "请加机器人为好友，私聊发送「/p 状态」查看对方联系方式。",
            )
            await self._notice(
                b["qq"],
                "✅ 双方已确认！\n"
                f"对方：{name_a}（QQ：{a['qq']}）\n"
                f"对方 Steam：{a['contact_steam'] or '未填'}\n"
                "请主动加好友联机，结束后发送 /p 完成。",
                group_id=row["group_b"],
                fallback="你的星露谷匹配已双方确认，但私聊发送失败——"
                "请加机器人为好友，私聊发送「/p 状态」查看对方联系方式。",
            )

    async def _close_queue(self, db, qq: str, status: str = "cancelled"):
        await db.execute(
            "UPDATE queue SET status=? WHERE id=(SELECT id FROM queue WHERE qq=? "
            "AND status IN ('waiting','matched') ORDER BY id DESC LIMIT 1)",
            (status, qq),
        )

    async def _requeue(self, db, qq: str):
        now = self._now()
        ttl = self._cfg_int("queue_ttl_sec", 259200)
        row = await (
            await db.execute(
                "SELECT * FROM queue WHERE qq=? ORDER BY id DESC LIMIT 1", (qq,)
            )
        ).fetchone()
        if row:
            await db.execute(
                "UPDATE queue SET status='waiting', enqueued_at=?, expires_at=? WHERE id=?",
                (self._iso(now), self._iso(now + timedelta(seconds=ttl)), row["id"]),
            )
            await db.execute(
                "UPDATE players SET status='queued', updated_at=? WHERE qq=?",
                (self._iso(now), qq),
            )
        else:
            player = await (
                await db.execute("SELECT * FROM players WHERE qq=?", (qq,))
            ).fetchone()
            if player:
                prev = await (
                    await db.execute(
                        "SELECT group_id FROM queue WHERE qq=? AND group_id != '' "
                        "ORDER BY id DESC LIMIT 1",
                        (qq,),
                    )
                ).fetchone()
                gid = (prev["group_id"] if prev else "") or ""
                await db.execute(
                    """
                    INSERT INTO queue
                        (qq, nickname, pool, modded, time_slots, party_size, gender,
                         prefer_gender, group_id, enqueued_at, expires_at, status)
                    VALUES (?,?,?,?,?,?,?,?,?,?,?,'waiting')
                    """,
                    (
                        qq,
                        player["nickname"] or qq,
                        player["pool"],
                        player["modded"],
                        player["time_slots"],
                        player["party_size"],
                        player["gender"],
                        player["prefer_gender"],
                        gid,
                        self._iso(now),
                        self._iso(now + timedelta(seconds=ttl)),
                    ),
                )
                await db.execute(
                    "UPDATE players SET status='queued', updated_at=? WHERE qq=?",
                    (self._iso(), qq),
                )

    async def _is_banned(self, qq: str) -> bool:
        async with self._db() as db:
            row = await (
                await db.execute("SELECT until FROM bans WHERE qq=?", (qq,))
            ).fetchone()
            if not row:
                return False
            until = row["until"] or ""
            if until and until <= self._iso():
                await db.execute("DELETE FROM bans WHERE qq=?", (qq,))
                await db.commit()
                return False
            return True
