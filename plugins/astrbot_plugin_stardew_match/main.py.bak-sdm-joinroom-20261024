    async def _cmd_ban(self, event: AstrMessageEvent, arg: str):
        if not self._is_admin(event):
            await self._reply(event, "只有管理员可以执行该命令。")
            return
        target = self._extract_at(event)
        rest = arg
        if target:
            rest = rest.replace(f"@{target}", "").strip()
        if not target:
            parts = rest.split(None, 1)
            if parts and parts[0].isdigit():
                target = parts[0]
                rest = parts[1] if len(parts) > 1 else ""
        if not target or not target.isdigit():
            await self._reply(event, "用法：/p 封禁 @某人 [7d|24h|永久] [原因]")
            return
        duration, reason = self._parse_ban_args(rest)
        until = ""
        if duration is not None:
            until = self._iso(self._now() + timedelta(seconds=duration))
        async with self._db() as db:
            await db.execute(
                """
                INSERT INTO bans (qq, reason, until, created_at, created_by)
                VALUES (?,?,?,?,?)
                ON CONFLICT(qq) DO UPDATE SET
                    reason=excluded.reason, until=excluded.until,
                    created_at=excluded.created_at, created_by=excluded.created_by
                """,
                (target, reason, until, self._iso(), self._sender(event)),
            )
            await db.execute(
                "UPDATE queue SET status='cancelled' WHERE qq=? AND status='waiting'",
                (target,),
            )
            await db.execute(
                "UPDATE players SET status='banned', updated_at=? WHERE qq=?",
                (self._iso(), target),
            )
            await db.commit()
        await self._reply(
            event,
            f"已封禁 {target}" + (f"，到期：{until}" if until else "（永久）"),
        )

    @staticmethod
    def _parse_ban_args(text: str) -> tuple[int | None, str]:
        text = text.strip()
        if not text:
            return None, ""
        parts = text.split(None, 1)
        token = parts[0].lower()
        reason = parts[1] if len(parts) > 1 else ""
        if token in {"永久", "permanent", "forever", "0"}:
            return None, reason
        match = re.fullmatch(r"(\d+)([smhdw])", token)
        if not match:
            return None, text
        value = int(match.group(1))
        unit = match.group(2)
        seconds = value * {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[unit]
        return seconds, reason

