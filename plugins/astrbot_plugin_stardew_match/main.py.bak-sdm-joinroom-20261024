    async def _page_admin(self):
        body: dict = {}
        try:
            from astrbot.api.web import request as plugin_request

            payload = await plugin_request.json(default={})
            if isinstance(payload, dict):
                body = payload
        except Exception:  # noqa: BLE001
            logger.exception("[星露谷匹配] 读取管理请求失败")
            return {"ok": False, "message": "无法读取请求体"}

        def as_int(value, default: int = 0) -> int:
            try:
                return int(value)
            except (TypeError, ValueError):
                return default

        action = str(body.get("action") or "").strip()
        try:
            if action == "scan":
                expired = await self.rooms.expire()
                return {
                    "ok": True,
                    "message": (
                        f"已检查房间，清理 {expired} 个过期房间"
                        if expired
                        else "已检查房间，没有过期房间"
                    ),
                }
            if action == "force_fill":
                ok, message = await self.rooms.force_fill(
                    as_int(body.get("room_id"), 0)
                )
                return {"ok": ok, "message": message}
            if action == "dissolve_room":
                ok, message = await self.rooms.dissolve(
                    as_int(body.get("room_id"), 0)
                )
                return {"ok": ok, "message": message}
            if action == "match":
                return await self._admin_manual_match(
                    str(body.get("qq_a") or ""), str(body.get("qq_b") or "")
                )
            if action == "ban":
                return await self._admin_ban(
                    str(body.get("qq") or ""),
                    as_int(body.get("seconds"), 0),
                    str(body.get("reason") or "")[:200],
                )
            if action == "unban":
                return await self._admin_unban(str(body.get("qq") or ""))
            if action == "kick":
                return await self._admin_kick(str(body.get("qq") or ""))
            if action == "dissolve":
                return await self._admin_dissolve(as_int(body.get("match_id"), 0))
            if action == "resolve_report":
                return await self._admin_resolve_report(
                    as_int(body.get("report_id"), 0)
                )
        except Exception as exc:  # noqa: BLE001
            logger.exception("[星露谷匹配] 管理操作失败: %s", action)
            return {"ok": False, "message": f"操作失败：{exc}"}
        return {"ok": False, "message": "未知操作"}

    async def _admin_manual_match(self, qq_a: str, qq_b: str):
        qq_a, qq_b = qq_a.strip(), qq_b.strip()
        if not (qq_a.isdigit() and qq_b.isdigit()) or qq_a == qq_b:
            return {"ok": False, "message": "请选择两个不同的排队用户"}
        async with self._db() as db:
            a = await (
                await db.execute(
                    "SELECT * FROM queue WHERE qq=? AND status='waiting' "
                    "ORDER BY id DESC LIMIT 1",
                    (qq_a,),
                )
            ).fetchone()
            b = await (
                await db.execute(
                    "SELECT * FROM queue WHERE qq=? AND status='waiting' "
                    "ORDER BY id DESC LIMIT 1",
                    (qq_b,),
                )
            ).fetchone()
            if not a or not b:
                return {"ok": False, "message": "用户不在排队中"}
            await self._create_match(db, a, b, forced=True)
        return {
            "ok": True,
            "message": f"已强制撮合 {qq_a} 与 {qq_b}（已忽略所有匹配条件）",
        }

